DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/mahneshan?schema=public"
# Optional unpooled migration connection (Neon direct endpoint, sslmode=require).
# DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST/mahneshan?sslmode=require"
APP_URL="http://localhost:3000"
COOKIE_SECURE="false"
# Production: APP_URL=https://your-domain.example and COOKIE_SECURE=true.
# Comma-separated exact HTTPS image hostnames, configured before build.
IMAGE_HOSTS=""
# One-time production admin setup; remove ADMIN_PASSWORD after initialization.
# ADMIN_EMAIL="admin@your-domain.example"
# ADMIN_PASSWORD="REPLACE_WITH_A_UNIQUE_16_CHARACTER_OR_LONGER_PASSWORD"
SEED_ADMIN_EMAIL="admin@mahneshan.local"
SEED_ADMIN_PASSWORD="CHANGE_THIS_BEFORE_SEEDING"
